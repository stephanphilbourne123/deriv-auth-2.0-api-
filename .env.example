# Netlify environment variable template for the developer.
# Put real values in Netlify: Site configuration > Environment variables.
# Do NOT commit real tokens/secrets into the zip, GitHub, or frontend HTML.

# Public app/client identifier used by the OAuth start button.
DERIV_CLIENT_ID=replace_with_registered_client_id
DERIV_REDIRECT_URI=https://your-netlify-site.netlify.app/deriv/callback
DERIV_SCOPE=trade

# Server-only values, if the developer uses external services.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
